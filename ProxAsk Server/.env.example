# ==============================================================================
# PROXASK BACKEND ENVIRONMENT CONFIGURATION (.env)
# Location: ProxAsk Server/.env (or export in shell / IDE Run Configuration)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL)
# ------------------------------------------------------------------------------
# JDBC Connection URL for MySQL database
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/proxask_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true

# MySQL Database Username (accepts SPRING_DATASOURCE_USERNAME or MYSQL_USERNAME)
SPRING_DATASOURCE_USERNAME=root

# MySQL Database Password (accepts SPRING_DATASOURCE_PASSWORD or MYSQL_PASSWORD)
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# ------------------------------------------------------------------------------
# 2. NOSQL DATABASE CONFIGURATION (MongoDB)
# ------------------------------------------------------------------------------
# MongoDB connection URI (Atlas or local).
# Note: connectTimeoutMS=15000 and socketTimeoutMS=15000 prevent replica set timeouts on high-latency networks.
MONGODB_URI=mongodb://localhost:27017/proxask_db?connectTimeoutMS=15000&socketTimeoutMS=15000&serverSelectionTimeoutMS=15000&maxConnectionIdleTimeMS=60000&retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Secret key for signing and validating JWT tokens (HMAC-SHA256, 256+ bits)
# If omitted, application uses the default built-in key in application.properties
JWT_SECRET=af60addca9ea3e3c099551e1b6576c9966dce0a33de879dd7e160f86dbd872ca236d6e9ee66fb6e30039fe7c345324a10f3d0741b0600fa7a45df4c6691eff4f4209767ed39f51e37717d8feecd5dd14fc34ebe619e6a29ae91d9ffe134cb5718bec0b3680d6ae7fc09e67763fe7c05d05d3ba69f47211163852633755b7f861

# ------------------------------------------------------------------------------
# 4. APPLICATION SERVER URL
# ------------------------------------------------------------------------------
# Backend base URL used to generate email verification & password reset links
BACKEND_BASE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 5. EMAIL SERVICE (SMTP / GMAIL)
# ------------------------------------------------------------------------------
# Mail server host (default: smtp.gmail.com)
SPRING_MAIL_HOST=smtp.gmail.com

# Mail server port (default: 587 for TLS/STARTTLS)
SPRING_MAIL_PORT=587

# Gmail or SMTP account email address from which ProxAsk sends emails
EMAIL_ADDRESS=your_email@gmail.com

# Google 16-character App Password (NOT your regular Gmail login password)
# Generated from: https://myaccount.google.com/apppasswords
APP_PASSWORD=abcd efgh ijkl mnop
